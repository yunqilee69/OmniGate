# AI agent / dev tooling state
.omo/
.playwright-mcp/

# Runtime data & local config
/data/
/logs/
/config.yaml
/mock.*
/srv.pid

# SQLite
*.db
*.db-wal
*.db-shm

# Build artifacts
/omnigate
/omnigate.exe
/omnigate-*
/cmd/omnigate/omnigate

# Frontend build output (regenerated by `cd web && npm run build`)
# 仅跟踪 .gitkeep：go:embed 不允许空目录，新 clone 靠 Handler 占位页兜底
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Frontend deps (pnpm-lock + src 仍入仓)
/web/node_modules/

# npm wrapper: 下载的二进制(由 postinstall 重新拉取,不入仓)
/npm/vendor/

# OS noise
.DS_Store
Thumbs.db
npm/node_modules/
npm/package-lock.json
