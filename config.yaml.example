# OmniGate 启动层配置示例
# 说明:启动层决定"进程怎么起来"(监听地址、管理鉴权);运行层(熔断/限流/内容捕获等)在 Web 管理界面中改并热生效。
# 真实配置文件 config.yaml 在首次启动时若不存在会自动生成,本文件仅作打包进 release tarball 的样例。

server:
  # 监听地址。默认 127.0.0.1:17777,管理界面与代理共用此端口。
  # 仅本机访问:保持 127.0.0.1;局域网/公网访问:改为 0.0.0.0:17777
  listen: 127.0.0.1:17777

admin:
  # 账号密码(Web 管理台登录):设置后进入管理台需登录;同时也可作为 /v1 调用凭据。
  # 用户名不可包含冒号;API 调用遵循 HTTP Basic 规则(RFC 7617):
  #   Authorization: Basic base64(用户名:密码)
  # OpenAI SDK 场景 api_key 可直接填 base64(用户名:密码) 或 "用户名:密码" 原文(Bearer 传递)。
  username: ""
  password: ""

  # 网关 API 密钥(调用 /v1 专用,不用于 Web 登录):设置后 /v1 需携带
  #   Authorization: Bearer <api_key>
  # 与账号密码凭据任选其一;账号密码留空而仅设此项 = 本地免登录 + 远程调用带密钥。
  # 留空 = /v1 无鉴权(适合纯本地单机使用)。
  api_key: ""
