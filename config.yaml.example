# OmniGate 启动层配置示例
# 说明:启动层决定"进程怎么起来"(监听地址、管理令牌);运行层(熔断/限流/内容捕获等)在 Web 管理界面中改并热生效。
# 真实配置文件 config.yaml 在首次启动时若不存在会自动生成,本文件仅作打包进 release tarball 的样例。

server:
  # 监听地址。默认 127.0.0.1:17777,管理界面与代理共用此端口。
  # 仅本机访问:保持 127.0.0.1;局域网/公网访问:改为 0.0.0.0:17777
  listen: 127.0.0.1:17777

admin:
  # 管理面访问令牌。留空 = 管理面无鉴权(适合纯本地单机使用)。
  # 设置后,所有 /api/* 请求必须携带 X-Admin-Token 头;/v1/* 代理面永不需要鉴权。
  token: ""
